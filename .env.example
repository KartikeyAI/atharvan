# Non-secret deployment identity.
ATHARVAN_ENVIRONMENT=development
ATHARVAN_PUBLIC_ORIGIN=http://localhost:3000

# Dedicated Atharvan development Neon connection string, including SSL parameters.
DATABASE_URL=
# Independent random secrets, each at least 32 characters.
BETTER_AUTH_SECRET=
ATHARVAN_VERIFICATION_HMAC_SECRET=
# Dedicated production key for non-reversible email recipient fingerprints.
# ATHARVAN_EMAIL_RECIPIENT_HMAC_SECRET=
ATHARVAN_SUPER_ADMIN_EMAIL=

# Transactional email sender identity uses the verified Resend domain.
ATHARVAN_EMAIL_FROM=Atharvan <login@updates.arth.sh>
# Optional distribution address for durable operational alert and recovery emails.
# ATHARVAN_ALERT_EMAIL_TO=
# Optional until testing invitation and OTP email delivery.
# RESEND_API_KEY=
# Optional outside production; verifies delivery, bounce, and complaint webhooks.
# RESEND_WEBHOOK_SECRET=

# Optional: configure all three to enable secret create/rotate/revoke.
# The dedicated token needs Secrets Store read and write access.
# CLOUDFLARE_SECRETS_STORE_ACCOUNT_ID=
# CLOUDFLARE_SECRETS_STORE_ID=
# CLOUDFLARE_SECRETS_STORE_API_TOKEN=

# Optional until the Arth consumer is deployed. Configure all current values.
# The previous pair is accepted only during a bounded credential rotation.
# ATHARVAN_ARTH_CURRENT_KEY_ID=arth-development-2026-01
# ATHARVAN_ARTH_CURRENT_SHARED_SECRET=
# ATHARVAN_ARTH_PREVIOUS_KEY_ID=
# ATHARVAN_ARTH_PREVIOUS_SHARED_SECRET=
# ATHARVAN_ARTH_AUDIENCE=https://atharvan.example.com/v1/internal/arth
